#!/usr/bin/env bash

# Benchmark info
echo "TIMING - Starting main script at: $(date)"

# Set working directory to home directory
cd "${HOME}"

# Clear any existing XDG_RUNTIME_DIR to avoid warnings from dconf
unset XDG_RUNTIME_DIR

<%- unless context.modules.blank? -%>
# Purge the module environment to avoid conflicts
module purge

# Load the require modules
module load <%= context.modules %>

# List loaded modules
module list
<%- end -%>

# Benchmark info
echo "TIMING - Starting Jupyter at: $(date)"

# Print the Jupyter token and connection URL for user convenience
echo "Jupyter token: ${password}"
echo "Connection URL: https://${host}:${PORT}/tree?token=${password}"

# Launch Jupyter Notebook inside the container
set -x
apptainer exec -B "${BIND_DIR}" "${CONTAINER}" \
  jupyter notebook \
    --no-browser \
    --port="${PORT}" \
    --ip="${host}" \
    --notebook-dir="${NOTEBOOK_DIR}" \
    --NotebookApp.token="${password}" \
    --NotebookApp.allow_origin="*"
