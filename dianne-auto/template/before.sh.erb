# This script (`before.sh.erb`) is sourced directly into the main Bash script
# that is run when the batch job starts up. It is called before the `script.sh`
# is forked off into a separate process.
#
# There are some helpful Bash functions that are made available to this script
# that encapsulate commonly used routines when initializing a web server:
#
#   - find_port
#       Find available port in range [$1..$2]
#       Default: 2000 65535
#
#   - create_passwd
#       Generate random alphanumeric password with $1 characters
#       Default: 32
#
# We **MUST** supply the following environment variables in this
# `before.sh.erb` script so that a user can connect back to the web server when
# it is running (case-sensitive variable names):
#
#   - $host (already defined earlier, so no need to define again)
#       The host that the web server is listening on
#
#   - $port
#       The port that the web server is listening on
#
#   - $password
#       The plain text password used to authenticate to the web server with

# Export the module function if it exists
[[ $(type -t module) == "function" ]] && export -f module

# Find available port to run server on
port=$(find_port)
export PORT="${port}"


# Generate password used as the Jupyter token
password="$(create_passwd 16)"
export password
export BC_PASSWORD="$password"

# Clone or update the repository before starting the server
REPO_DIR="$HOME/dianne-codebase"
if [ ! -d "$REPO_DIR" ]; then
  git clone https://github.com/TheJacksonLaboratory/DIANNE.git "$REPO_DIR"
else
  git -C "$REPO_DIR" pull
fi

# Define container and bind paths
export CONTAINER="/projects/chuang-lab/USERS/domans/containers/scanpy-seurat-v3.sif"
export BIND_DIR="/projects/"

# Infer the directory chosen in the form, which is a full path to a notebook, and set the NOTEBOOK_DIR to the parent directory of that path
NOTEBOOK_PATH="<%= context.custom_notebook_dir %>"
custom_notebook_path="$NOTEBOOK_PATH"
export custom_notebook_path
custom_notebook_name="$(basename "$NOTEBOOK_PATH")"
export custom_notebook_name
echo "Custom notebook path: $custom_notebook_path" >> "$PWD/output.log"
NOTEBOOK_DIR="$(dirname "$NOTEBOOK_PATH")"
export NOTEBOOK_DIR
custom_notebook_dir="$NOTEBOOK_DIR"
echo "NOTEBOOK_DIR is set to: $NOTEBOOK_DIR" >> "$PWD/output.log"
